# Required: the private Ollama host, including its port.
OLLAMA_BASE_URL=http://192.0.2.10:11434

# These defaults are used when omitted.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b-q8_0
OLLAMA_CHAT_MODEL=qwen3:8b

# Optional: reject weak semantic matches after retrieval calibration.
# Leave unset until a baseline evaluation establishes a suitable value.
RAG_MIN_RELEVANCE_SCORE=

# Optional LangSmith tracing for the RAG request and model calls.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-backend
